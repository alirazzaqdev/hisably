{
  "$schema": "Shared invoice-math test fixtures. Loaded by both packages/shared (TS) and apps/api (Python) test suites so the two implementations are guaranteed to agree to the fils. All monetary fields are integer fils.",
  "country": "AE",
  "cases": [
    {
      "name": "simple_standard_rate",
      "input": { "description": "Item A", "quantity": 2, "unit_price": 1000, "vat_category": "standard" },
      "expected": { "quantity": 2, "computed_gross": 2000, "gross_amount": 2000, "discount_applied": 0, "taxable_amount": 2000, "vat_rate": 5, "vat_amount": 100, "line_total": 2100 }
    },
    {
      "name": "sqm_line",
      "input": { "description": "Glass panel", "width_mm": 2500, "height_mm": 1200, "unit_price": 500, "vat_category": "standard" },
      "expected": { "quantity": 3, "computed_gross": 1500, "gross_amount": 1500, "discount_applied": 0, "taxable_amount": 1500, "vat_rate": 5, "vat_amount": 75, "line_total": 1575 }
    },
    {
      "name": "sqm_line_with_quantity",
      "input": { "description": "Glass panel", "width_mm": 6450, "height_mm": 5650, "quantity": 1, "unit_price": 110000, "vat_category": "standard" },
      "expected": { "quantity": 36.4425, "computed_gross": 4008675, "gross_amount": 4008675, "discount_applied": 0, "taxable_amount": 4008675, "vat_rate": 5, "vat_amount": 200434, "line_total": 4209109 }
    },
    {
      "name": "lm_line",
      "input": { "description": "Aluminium profile", "length_mm": 3000, "quantity": 2, "unit_price": 1000, "vat_category": "standard" },
      "expected": { "quantity": 6, "computed_gross": 6000, "gross_amount": 6000, "discount_applied": 0, "taxable_amount": 6000, "vat_rate": 5, "vat_amount": 300, "line_total": 6300 }
    },
    {
      "name": "sqm_line_with_override_total",
      "input": { "description": "Glass panel", "width_mm": 2500, "height_mm": 1200, "unit_price": 500, "override_total": 1400, "vat_category": "standard" },
      "expected": { "quantity": 3, "computed_gross": 1500, "gross_amount": 1400, "discount_applied": 0, "taxable_amount": 1400, "vat_rate": 5, "vat_amount": 70, "line_total": 1470 }
    },
    {
      "name": "final_payment_factor_milestone",
      "input": { "description": "Milestone billing", "quantity": 10, "unit_price": 10000, "final_payment_factor": 0.5, "vat_category": "standard" },
      "expected": { "quantity": 10, "computed_gross": 50000, "gross_amount": 50000, "discount_applied": 0, "taxable_amount": 50000, "vat_rate": 5, "vat_amount": 2500, "line_total": 52500 }
    },
    {

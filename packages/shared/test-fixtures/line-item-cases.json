      "expected": { "quantity": 1, "computed_gross": 1000, "gross_amount": 1000, "discount_applied": 0, "taxable_amount": 1000, "vat_rate": 0, "vat_amount": 0, "line_total": 1000 }
    },
    {
      "name": "vat_rounds_half_away_from_zero",
      "input": { "description": "Item D", "quantity": 3, "unit_price": 333, "vat_category": "standard" },
      "expected": { "quantity": 3, "computed_gross": 999, "gross_amount": 999, "discount_applied": 0, "taxable_amount": 999, "vat_rate": 5, "vat_amount": 50, "line_total": 1049 }

    },
    {
      "name": "fixed_discount_takes_precedence",
      "input": { "description": "Item C", "quantity": 1, "unit_price": 2000, "discount_amount": 150, "discount_percent": 50, "vat_category": "standard" },
      "expected": { "quantity": 1, "computed_gross": 2000, "gross_amount": 2000, "discount_applied": 150, "taxable_amount": 1850, "vat_rate": 5, "vat_amount": 93, "line_total": 1943 }
